# Preferred names (Neon Vercel storage: rowgon_storage)
rowgon_storage_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
rowgon_storage_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Also accepted from the same storage:
# rowgon_storage_POSTGRES_URL=
# rowgon_storage_POSTGRES_PRISMA_URL=
# rowgon_storage_POSTGRES_URL_NON_POOLING=

# Older fallbacks still accepted:
# ROWGON_DATABASE_URL=
# ROWGON_DATABASE_URL_UNPOOLED=
# TheHollowCrown_DATABASE_URL=
# TheHollowCrown_DATABASE_URL_UNPOOLED=
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Email (Resend) — verification codes, welcome, password reset
# onboarding@resend.dev can ONLY send to your Resend account email.
# For real users: verify rowgon.com at resend.com/domains and set EMAIL_FROM to it.
# Also add SPF/DKIM/DMARC at your DNS host so messages land in inbox, not spam.
RESEND_API_KEY=
EMAIL_FROM="Rowgon <noreply@rowgon.com>"
# Optional reply address on the same verified domain
EMAIL_REPLY_TO=
# Public site URL used in email links (optional on Vercel; falls back to VERCEL_URL)
APP_URL="https://rowgon.com"

# Ably realtime (push badges/chat/task updates — replaces /api/pulse polling when set)
# Root API key from https://ably.com/dashboard — kept server-side only.
# Browsers auth via /api/ably/auth (token request). Without this, LiveRefresh polling is used.
ABLY_API_KEY=

# -----------------------------------------------------------------------------
# Infra bootstrap (payments / files / cron / SSO) — no plan UI yet
# -----------------------------------------------------------------------------

# Stripe (TEST keys first). Secrets are server-only — never expose STRIPE_SECRET_KEY.
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Local webhooks: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional price ids (leave empty until monetization feature work)
# STRIPE_PRICE_TEAM_MONTHLY=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Cloudflare R2 (private bucket — Neon holds metadata only, never file bytes)
# https://developers.cloudflare.com/r2/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional CDN/public base — default is private signed URLs only
# R2_PUBLIC_BASE_URL=

# Vercel Cron — required for /api/cron/* routes
# Vercel sends Authorization: Bearer $CRON_SECRET automatically when set.
# Local: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/retention-purge
CRON_SECRET=

# WorkOS SSO scaffold — DISABLED by default. Password auth stays primary.
# Set ENABLE_SSO=true only in controlled environments while testing.
ENABLE_SSO=false
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI="http://localhost:3000/api/sso/callback"
# WORKOS_WEBHOOK_SECRET=

# Virus scanning: intentionally deferred. Do not set scan vendors yet.
