{
  "buildCommand": "npm run vercel-build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/retention-purge",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/seat-renewal",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/dunning",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 1"
    }
  ]
}
